# Install (adjust paths for the machine, then):
#   sudo cp local_orchestrator/trigger/systemd/subdron-pipeline-trigger.* /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now subdron-pipeline-trigger.timer
# Watch it:  journalctl -u subdron-pipeline-trigger -f
[Unit]
Description=Subdron local pipeline trigger (one pass)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=joao
WorkingDirectory=/home/joao/Desktop/bitbucket/subdron_pipelines
Environment=MISSION_DB_PORT=5434
Environment=PYTHONUNBUFFERED=1
# For a shared machine, point everyone at a common data root:
# Environment=DATA_ROOT=/srv/subdron/data
ExecStart=/home/joao/.pyenv/versions/pipelines/bin/python local_orchestrator/trigger/pipeline_trigger.py --dev-code extraction
