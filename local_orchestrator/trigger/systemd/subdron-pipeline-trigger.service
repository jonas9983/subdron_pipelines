# Installed by subdron_missions_database/setup_host.sh, which fills in User,
# WorkingDirectory and the interpreter for the machine.
# Watch it:  journalctl -u subdron-pipeline-trigger -f
[Unit]
Description=Subdron local pipeline trigger (one pass)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=joao
WorkingDirectory=/home/joao/Desktop/bitbucket/subdron_pipelines
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/joao/.pyenv/versions/pipelines/bin/python local_orchestrator/trigger/pipeline_trigger.py
