# Installed by subdron_missions_database/setup_host.sh, which fills in User,
# WorkingDirectory and the interpreter for the machine.
# Open:  http://<machine>:8090
[Unit]
Description=Subdron pipeline status dashboard
After=network.target

[Service]
User=joao
WorkingDirectory=/home/joao/Desktop/bitbucket/subdron_pipelines
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/joao/.pyenv/versions/pipelines/bin/python local_orchestrator/trigger/pipeline_dashboard.py
Restart=on-failure

[Install]
WantedBy=multi-user.target
